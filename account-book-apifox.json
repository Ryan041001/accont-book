{
  "apifoxProject": {
    "name": "Account Book 记账本微服务API",
    "version": "1.0.0",
    "description": "记账本微服务系统的完整API文档，包含用户认证、资产管理、交易流水、统计服务等模块"
  },
  "info": {
    "name": "记账本微服务API",
    "version": "1.0.0",
    "description": "基于Spring Cloud的记账本微服务系统API集合",
    "_postman_id": "account-book-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "servers": [
    {
      "url": "http://localhost:9000",
      "description": "开发环境 - Gateway网关"
    }
  ],
  "item": [
    {
      "name": "用户认证模块",
      "description": "用户注册、登录、JWT Token管理",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "注册新用户账号。用户名唯一，重复注册会返回错误。"
          },
          "response": [
            {
              "name": "注册成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"注册成功\",\n  \"data\": {\n    \"id\": 1,\n    \"username\": \"testuser\"\n  }\n}"
            },
            {
              "name": "用户名已存在",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"code\": 500,\n  \"message\": \"用户名已存在\"\n}"
            }
          ]
        },
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            },
            "description": "用户登录，成功后返回JWT Token，用于后续API调用的认证。"
          },
          "response": [
            {
              "name": "登录成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"登录成功\",\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"username\": \"testuser\"\n  }\n}"
            },
            {
              "name": "密码错误",
              "status": "Internal Server Error",
              "code": 500,
              "body": "{\n  \"code\": 500,\n  \"message\": \"密码错误\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "资产管理模块",
      "description": "管理用户的资产账户，包括查询、创建、修改和删除",
      "item": [
        {
          "name": "查询用户资产列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT认证令牌"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "user", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "用户ID"
                }
              ]
            },
            "description": "查询指定用户的所有资产账户列表。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": [\n    {\n      \"id\": 1,\n      \"userId\": 1,\n      \"name\": \"工资卡\",\n      \"balance\": 5000.00,\n      \"createTime\": \"2026-01-01T10:00:00\",\n      \"updateTime\": \"2026-01-09T12:00:00\"\n    },\n    {\n      \"id\": 2,\n      \"userId\": 1,\n      \"name\": \"支付宝\",\n      \"balance\": 1200.50,\n      \"createTime\": \"2026-01-01T10:00:00\",\n      \"updateTime\": \"2026-01-09T12:00:00\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "查询单个资产详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/:assetId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", ":assetId"],
              "variable": [
                {
                  "key": "assetId",
                  "value": "1",
                  "description": "资产ID"
                }
              ]
            },
            "description": "根据资产ID查询单个资产的详细信息。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"id\": 1,\n    \"userId\": 1,\n    \"name\": \"工资卡\",\n    \"balance\": 5000.00,\n    \"createTime\": \"2026-01-01T10:00:00\",\n    \"updateTime\": \"2026-01-09T12:00:00\"\n  }\n}"
            },
            {
              "name": "资产不存在",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"code\": 404,\n  \"message\": \"资产不存在\"\n}"
            }
          ]
        },
        {
          "name": "创建新资产账户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"name\": \"测试账户\",\n  \"balance\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets"]
            },
            "description": "为用户创建新的资产账户，可设置初始余额。"
          },
          "response": [
            {
              "name": "创建成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"创建成功\",\n  \"data\": {\n    \"id\": 3,\n    \"userId\": 1,\n    \"name\": \"测试账户\",\n    \"balance\": 1000.00,\n    \"createTime\": \"2026-01-09T14:30:00\",\n    \"updateTime\": \"2026-01-09T14:30:00\"\n  }\n}"
            }
          ]
        },
        {
          "name": "修改资产名称",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"私房钱\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/:assetId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", ":assetId"],
              "variable": [
                {
                  "key": "assetId",
                  "value": "3",
                  "description": "资产ID"
                }
              ]
            },
            "description": "修改资产账户的名称。"
          },
          "response": [
            {
              "name": "修改成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"修改成功\",\n  \"data\": {\n    \"id\": 3,\n    \"userId\": 1,\n    \"name\": \"私房钱\",\n    \"balance\": 1000.00,\n    \"createTime\": \"2026-01-09T14:30:00\",\n    \"updateTime\": \"2026-01-09T15:00:00\"\n  }\n}"
            }
          ]
        },
        {
          "name": "删除资产账户",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/assets/:assetId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", ":assetId"],
              "variable": [
                {
                  "key": "assetId",
                  "value": "3",
                  "description": "资产ID"
                }
              ]
            },
            "description": "删除无流水记录的资产账户。如果资产有关联的交易流水，无法删除。"
          },
          "response": [
            {
              "name": "删除成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"删除成功\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "交易流水模块",
      "description": "管理收入、支出交易流水，支持余额自动更新和回滚",
      "item": [
        {
          "name": "新增支出记录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"assetId\": 1,\n  \"amount\": 50.00,\n  \"type\": 1,\n  \"category\": \"餐饮\",\n  \"description\": \"午餐\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "新增支出交易记录。type=1表示支出，会自动从资产账户扣减余额。"
          },
          "response": [
            {
              "name": "创建成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"创建成功\",\n  \"data\": {\n    \"id\": 1,\n    \"userId\": 1,\n    \"assetId\": 1,\n    \"amount\": 50.00,\n    \"type\": 1,\n    \"category\": \"餐饮\",\n    \"description\": \"午餐\",\n    \"createTime\": \"2026-01-09T12:00:00\"\n  }\n}"
            }
          ]
        },
        {
          "name": "新增收入记录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"assetId\": 1,\n  \"amount\": 200.00,\n  \"type\": 2,\n  \"category\": \"工资\",\n  \"description\": \"月度工资\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "新增收入交易记录。type=2表示收入，会自动向资产账户增加余额。"
          },
          "response": [
            {
              "name": "创建成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"创建成功\",\n  \"data\": {\n    \"id\": 2,\n    \"userId\": 1,\n    \"assetId\": 1,\n    \"amount\": 200.00,\n    \"type\": 2,\n    \"category\": \"工资\",\n    \"description\": \"月度工资\",\n    \"createTime\": \"2026-01-09T12:05:00\"\n  }\n}"
            }
          ]
        },
        {
          "name": "查询用户交易流水列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/user/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "user", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "用户ID"
                }
              ]
            },
            "description": "查询指定用户的所有交易流水记录。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": [\n    {\n      \"id\": 1,\n      \"userId\": 1,\n      \"assetId\": 1,\n      \"amount\": 50.00,\n      \"type\": 1,\n      \"category\": \"餐饮\",\n      \"description\": \"午餐\",\n      \"createTime\": \"2026-01-09T12:00:00\"\n    },\n    {\n      \"id\": 2,\n      \"userId\": 1,\n      \"assetId\": 1,\n      \"amount\": 200.00,\n      \"type\": 2,\n      \"category\": \"工资\",\n      \"description\": \"月度工资\",\n      \"createTime\": \"2026-01-09T12:05:00\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "删除交易流水(余额自动回滚)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/:transactionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", ":transactionId"],
              "variable": [
                {
                  "key": "transactionId",
                  "value": "1",
                  "description": "交易流水ID"
                }
              ]
            },
            "description": "删除交易流水记录。系统会自动回滚资产余额：删除支出记录则余额增加，删除收入记录则余额减少。"
          },
          "response": [
            {
              "name": "删除成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"删除成功，余额已回滚\"\n}"
            },
            {
              "name": "交易不存在",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"code\": 404,\n  \"message\": \"交易记录不存在\"\n}"
            }
          ]
        },
        {
          "name": "参数校验-负数金额(应失败)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"assetId\": 1,\n  \"amount\": -10.00,\n  \"type\": 1,\n  \"category\": \"测试\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "测试参数校验：提交负数金额应该返回400错误。"
          },
          "response": [
            {
              "name": "参数校验失败",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"code\": 400,\n  \"message\": \"金额必须大于0\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "统计服务模块",
      "description": "提供月度统计、分类统计、概览等数据分析功能",
      "item": [
        {
          "name": "获取当月概览",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats/summary/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "summary", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "用户ID"
                }
              ]
            },
            "description": "获取用户当月的收入、支出、余额等概览数据。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"userId\": 1,\n    \"totalIncome\": 5000.00,\n    \"totalExpense\": 1200.50,\n    \"balance\": 3799.50,\n    \"month\": \"2026-01\"\n  }\n}"
            }
          ]
        },
        {
          "name": "获取月度统计",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats/monthly/:userId?months=6",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "monthly", ":userId"],
              "query": [
                {
                  "key": "months",
                  "value": "6",
                  "description": "查询最近几个月的数据"
                }
              ],
              "variable": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "用户ID"
                }
              ]
            },
            "description": "获取用户最近N个月的月度收支统计数据。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": [\n    {\n      \"month\": \"2026-01\",\n      \"income\": 5000.00,\n      \"expense\": 1200.50\n    },\n    {\n      \"month\": \"2025-12\",\n      \"income\": 4800.00,\n      \"expense\": 1500.00\n    },\n    {\n      \"month\": \"2025-11\",\n      \"income\": 5200.00,\n      \"expense\": 1350.00\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "获取分类统计",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stats/category/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stats", "category", ":userId"],
              "variable": [
                {
                  "key": "userId",
                  "value": "1",
                  "description": "用户ID"
                }
              ]
            },
            "description": "获取用户按分类统计的收支数据，如餐饮、交通、工资等。"
          },
          "response": [
            {
              "name": "查询成功",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"expense\": [\n      {\n        \"category\": \"餐饮\",\n        \"amount\": 600.00,\n        \"count\": 15\n      },\n      {\n        \"category\": \"交通\",\n        \"amount\": 300.50,\n        \"count\": 10\n      },\n      {\n        \"category\": \"购物\",\n        \"amount\": 300.00,\n        \"count\": 5\n      }\n    ],\n    \"income\": [\n      {\n        \"category\": \"工资\",\n        \"amount\": 5000.00,\n        \"count\": 1\n      }\n    ]\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "服务健康检查",
      "description": "检查各个微服务的运行状态",
      "item": [
        {
          "name": "Gateway健康检查",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:9000/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "9000",
              "path": ["actuator", "health"]
            },
            "description": "检查Gateway网关服务是否正常运行。"
          },
          "response": [
            {
              "name": "服务正常",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\"\n}"
            }
          ]
        },
        {
          "name": "User Service健康检查",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8081/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["actuator", "health"]
            },
            "description": "检查User Service用户服务是否正常运行。"
          },
          "response": [
            {
              "name": "服务正常",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\"\n}"
            }
          ]
        },
        {
          "name": "Asset Service健康检查",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8082/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["actuator", "health"]
            },
            "description": "检查Asset Service资产服务是否正常运行。"
          },
          "response": [
            {
              "name": "服务正常",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\"\n}"
            }
          ]
        },
        {
          "name": "Transaction Service健康检查",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8083/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8083",
              "path": ["actuator", "health"]
            },
            "description": "检查Transaction Service交易服务是否正常运行。"
          },
          "response": [
            {
              "name": "服务正常",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"UP\"\n}"
            }
          ]
        },
        {
